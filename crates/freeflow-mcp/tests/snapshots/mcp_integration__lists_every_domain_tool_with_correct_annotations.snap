      },
      "mission_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "payment_terms_days": {
        "description": "Délai de paiement en jours (défaut : 30).",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      }
